# Copy to .env for local runs. Never commit real values.
DATABASE_URL=postgres://topfornow:topfornow@localhost:5432/topfornow?sslmode=disable
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_USERNAME=owner
ADMIN_PASSWORD=change-me
OWNER_TZ=Asia/Kolkata
BASE_URL=http://localhost:8080
PORT=8080
# sandbox (built-in simulator) | dodo_test | dodo_live
PAYMENT_MODE=sandbox
# Dodo modes only:
DODO_API_KEY=
DODO_PRODUCT_ID=
DODO_WEBHOOK_SECRET=
# Per-payment ceiling in cents. Checkout closes above it (price never skips).
MAX_CHECKOUT_CENTS=500000
# Set to true behind Fly/Render/any proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Live mode refuses to start unless this is exactly:
# LIVE_PAYMENTS_APPROVED=yes-the-owner-approved-real-charges
